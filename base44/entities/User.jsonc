{
  "name": "User",
  "type": "object",
  "properties": {
    "subscription_status": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free",
      "description": "User's subscription status"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID for billing"
    },
    "font_size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "extra-large"
      ],
      "default": "medium",
      "description": "Preferred font size for the app"
    }
  },
  "required": [
    "stripe_customer_id"
  ]
}